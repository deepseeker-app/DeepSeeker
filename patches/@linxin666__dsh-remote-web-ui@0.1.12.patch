+  /** Atomically replace the complete device set without storing bearer cookies. */
+  replace(devices: readonly PersistedDeviceSession[]): void {
+    if (devices.length > MAX_PERSISTED_DEVICES) {
+      throw new Error('remote-web-ui: too many persisted pairing devices')
+    }
+    const keys = new Set<string>()
+    for (const device of devices) {
+      assertDevice(device)
+      if (keys.has(device.key)) throw new Error('remote-web-ui: persisted pairing device is duplicated')
+      keys.add(device.key)
+    }
