+/** Private, profile-scoped persistence for paired-device authorization. */
+
+import { randomUUID } from 'node:crypto'
+import {
+  chmodSync,
+  lstatSync,
+  mkdirSync,
+  readFileSync,
+  renameSync,
+  unlinkSync,
+  writeFileSync,
+} from 'node:fs'
+import { homedir } from 'node:os'
+import { basename, dirname, join, resolve } from 'node:path'
+
+const STATE_VERSION = 1
+const MAX_STATE_BYTES = 64 * 1024
+const MAX_PERSISTED_DEVICES = 64
+const PRIVATE_DIRECTORY_MODE = 0o700
+const PRIVATE_FILE_MODE = 0o600
+const DEVICE_KEY_PATTERN = /^[0-9a-f]{64}$/u
+
+/** One persisted device session, keyed by a SHA-256 digest of the bearer cookie. */
+export interface PersistedDeviceSession {
+  readonly key: string
+  readonly createdAt: number
+  readonly lastSeenAt: number
+}
+
+/** Durable device-set operations used by the pairing state machine. */
+export interface PairingPersistence {
+  /** Load the last committed authorization set. */
+  load(): readonly PersistedDeviceSession[]
+  /** Atomically replace the complete authorization set. */
+  replace(devices: readonly PersistedDeviceSession[]): void
+}
+
+interface StoredPairingState {
+  readonly version: 1
+  readonly devices: readonly PersistedDeviceSession[]
+}
+
+function assertDevice(device: PersistedDeviceSession): void {
+  if (!DEVICE_KEY_PATTERN.test(device.key)
+    || !Number.isSafeInteger(device.createdAt)
+    || !Number.isSafeInteger(device.lastSeenAt)
+    || device.createdAt < 0
+    || device.lastSeenAt < device.createdAt) {
+    throw new Error('remote-web-ui: persisted pairing device is invalid')
+  }
+}
+
+function parseState(text: string): readonly PersistedDeviceSession[] {
+  const value: unknown = JSON.parse(text)
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('remote-web-ui: persisted pairing state must be an object')
+  }
+  const state = value as Record<string, unknown>
+  if (state.version !== STATE_VERSION || !Array.isArray(state.devices)
+    || state.devices.length > MAX_PERSISTED_DEVICES) {
+    throw new Error('remote-web-ui: persisted pairing state is invalid')
+  }
+  const devices: PersistedDeviceSession[] = []
+  const keys = new Set<string>()
