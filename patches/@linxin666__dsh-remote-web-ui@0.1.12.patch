+/** One approval request. The resolved mux frame, not the HTTP receipt, removes it. */
+function ApprovalCard({ interaction }: { interaction: Extract<PendingInteraction, { kind: 'approval' }> }) {
+  const [busy, setBusy] = useState<'allow' | 'reject' | null>(null)
+  const [error, setError] = useState<string | undefined>(undefined)
+  const { request } = interaction
+
+  const decide = useCallback(async (outcome: 'allowed-once' | 'rejected') => {
