+++ b/src/mobile/pair-boot.ts
@@ -0,0 +1,80 @@
+/** Pairing bootstrap for the standalone mobile surface. */
+
+/** Minimal page surface used by the bootstrap and its tests. */
+export interface MobilePairPage {
+  /** Current absolute page URL. */
+  href: string
+  /** Replace the visible URL without reloading the page. */
+  replaceState(url: string): void
+}
+
+/** Injectable fetch face used by the bootstrap. */
+export type MobilePairFetch = (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+
+/** Result consumed by the mobile entry before it mounts the application. */
+export type MobilePairBootResult =
+  | { kind: 'ready' }
+  | { kind: 'unpaired' }
+  | { kind: 'failed'; reason: 'accept' | 'status' }
+
+/** Browser page implementation. */
+export const browserMobilePairPage: MobilePairPage = {
+  get href(): string {
+    return window.location.href
+  },
+  replaceState(url: string): void {
+    window.history.replaceState(null, '', url)
+  },
+}
+
+/** Remove the one-time secret from the address bar before rendering. */
+function stripPair(page: MobilePairPage): void {
+  const url = new URL(page.href)
+  url.searchParams.delete('pair')
+  page.replaceState(`${url.pathname}${url.search}${url.hash}`)
+}
+
+/** Verify that the paired-device cookie is active on the current origin. */
+async function readPairStatus(fetcher: MobilePairFetch): Promise<MobilePairBootResult> {
+  try {
+    const response = await fetcher('/api/pair/status', { credentials: 'same-origin' })
+    if (!response.ok) return { kind: 'failed', reason: 'status' }
+    const body = await response.json() as { paired?: unknown }
+    return body.paired === true ? { kind: 'ready' } : { kind: 'unpaired' }
+  } catch {
+    return { kind: 'failed', reason: 'status' }
+  }
+}
+
+/**
+ * Establish or verify the paired-device cookie before any mobile API call.
+ * The `/m` HTML and bundle are intentionally public; all user data remains
+ * behind the existing paired-device gate.
+ */
+export async function bootMobilePair(
+  page: MobilePairPage = browserMobilePairPage,
+  fetcher: MobilePairFetch = fetch,
+): Promise<MobilePairBootResult> {
+  const url = new URL(page.href)
+  const token = url.searchParams.get('pair')
+  if (token !== null) {
+    let accepted = false
+    try {
+      const response = await fetcher('/api/pair/accept', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ token }),
+      })
+      accepted = response.ok
+    } catch {
+      accepted = false
+    }
+    stripPair(page)
+    if (!accepted) return { kind: 'failed', reason: 'accept' }
+    const status = await readPairStatus(fetcher)
+    return status.kind === 'ready' ? status : { kind: 'failed', reason: 'status' }
+  }
+
+  return readPairStatus(fetcher)
+}
