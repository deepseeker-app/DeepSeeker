+      }
+    } catch (cause) {
+      if ((cause as NodeJS.ErrnoException).code !== 'ENOENT') throw cause
+    }
+    const temporary = join(directory, `.${basename(this.filename)}.${process.pid}.${randomUUID()}.tmp`)
+    const state: StoredPairingState = { version: STATE_VERSION, devices }
+    try {
+      writeFileSync(temporary, `${JSON.stringify(state, undefined, 2)}\n`, {
+        encoding: 'utf8',
+        flag: 'wx',
+        mode: PRIVATE_FILE_MODE,
+      })
+      chmodSync(temporary, PRIVATE_FILE_MODE)
+      renameSync(temporary, this.filename)
+      chmodSync(this.filename, PRIVATE_FILE_MODE)
+    } finally {
+      unlinkIfPresent(temporary)
+    }
+  }
+}
