+/** Host-persisted task ledger routes with paired-device authorization. */
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import type { Context } from '@deepseek-ai/cordis'
+import type { WebRoute } from '@deepseek-ai/dsh-host-webserver'
+import { parseLedger } from '../core/store.ts'
+import type { TaskRecord } from '../core/tasks.ts'
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    /** Live paired-device authorization decision from remote-web-ui. @mode bail */
+    'remote-web-ui/authorize-http'(request: IncomingMessage): 'allow' | 'deny' | undefined
+  }
+}
+
+export const TASK_BOARD_LEDGER_PATH = '/task-board/ledger'
+export const TASK_BOARD_EVENTS_PATH = '/task-board/events'
+
+const MAX_BODY_BYTES = 2 * 1024 * 1024
+const AUTH_RECHECK_MS = 5_000
+const HEARTBEAT_MS = 15_000
+
+/** One durable Host ledger document. */
+export interface TaskBoardLedger {
+  revision: number
+  tasks: TaskRecord[]
+}
+
+/** Settings-backed persistence face used by the route layer. */
+export interface TaskBoardLedgerScope {
+  get(): TaskBoardLedger
+  replace(next: TaskBoardLedger): Promise<void>
+}
+
+function cloneLedger(value: TaskBoardLedger): TaskBoardLedger {
+  return {
+    revision: value.revision,
+    tasks: parseLedger(JSON.stringify(value.tasks)),
+  }
+}
+
+/** True only for a direct loopback socket with a loopback Host header. */
+function isLoopbackRequest(req: IncomingMessage, host: URL): boolean {
+  const address = req.socket.remoteAddress?.toLowerCase()
+  if (address === undefined) return false
+  const v4 = address.startsWith('::ffff:') ? address.slice('::ffff:'.length) : address
+  const socketParts = v4.split('.')
+  const loopbackSocket = address === '::1'
+    || socketParts.length === 4
+      && socketParts[0] === '127'
+      && socketParts.every(part => /^\d{1,3}$/.test(part) && Number(part) <= 255)
+  const hostname = host.hostname
+  const hostParts = hostname.split('.')
+  const loopbackHost = hostname === 'localhost' || hostname === '[::1]'
+    || hostParts.length === 4
+      && hostParts[0] === '127'
+      && hostParts.every(part => /^\d{1,3}$/.test(part) && Number(part) <= 255)
+  return loopbackSocket && loopbackHost
+}
+
+/** Same-origin loopback or a currently paired remote device. */
+export function authorizeTaskBoardRequest(ctx: Context, req: IncomingMessage): boolean {
+  if (req.headers['sec-fetch-site'] === 'cross-site') return false
+  const rawHost = req.headers.host
+  if (typeof rawHost !== 'string') return false
+  let host: URL
+  try {
+    host = new URL(`http://${rawHost}`)
+  } catch {
+    return false
+  }
+  const origin = req.headers.origin
+  if (origin !== undefined) {
+    try {
+      if (new URL(origin).host !== host.host) return false
+    } catch {
+      return false
+    }
+  }
+  if (isLoopbackRequest(req, host)) return true
+  return ctx.bail(ctx, 'remote-web-ui/authorize-http', req) === 'allow'
+}
+
+function json(res: ServerResponse, status: number, value: TaskBoardLedger | { code: string }): void {
+  res.writeHead(status, {
+    'content-type': 'application/json; charset=utf-8',
+    'cache-control': 'no-store',
+    'x-content-type-options': 'nosniff',
+  })
+  res.end(JSON.stringify(status >= 400 && !('revision' in value)
+    ? { ok: false, error: value }
+    : { ok: true, value }))
+}
+
+async function readWrite(req: IncomingMessage): Promise<{ expectedRevision: number; tasks: TaskRecord[] } | undefined> {
+  const chunks: Buffer[] = []
+  let total = 0
+  for await (const chunk of req) {
+    const buffer = chunk as Buffer
+    total += buffer.length
+    if (total > MAX_BODY_BYTES) return undefined
+    chunks.push(buffer)
+  }
+  try {
+    const value: unknown = JSON.parse(Buffer.concat(chunks).toString('utf8'))
+    if (typeof value !== 'object' || value === null) return undefined
+    const record = value as Record<string, unknown>
+    if (!Number.isSafeInteger(record.expectedRevision) || (record.expectedRevision as number) < 0) return undefined
+    if (!Array.isArray(record.tasks)) return undefined
+    const tasks = parseLedger(JSON.stringify(record.tasks))
+    if (tasks.length !== record.tasks.length) return undefined
+    return { expectedRevision: record.expectedRevision as number, tasks }
+  } catch {
+    return undefined
+  }
+}
+
+interface Subscriber {
+  req: IncomingMessage
+  res: ServerResponse
+}
+
+/** Register the ledger read/write endpoints and the cross-client SSE feed. */
+export function registerTaskBoardRoutes(ctx: Context, scope: TaskBoardLedgerScope): () => void {
+  const subscribers = new Set<Subscriber>()
+  let writeTail: Promise<void> = Promise.resolve()
+
+  const current = (): TaskBoardLedger => cloneLedger(scope.get())
+  const publish = (revision: number): void => {
+    const frame = `data: ${JSON.stringify({ revision })}\n\n`
+    for (const subscriber of [...subscribers]) {
+      try {
+        subscriber.res.write(frame)
+      } catch {
+        subscribers.delete(subscriber)
+      }
+    }
+  }
+
+  const ledger: WebRoute = {
+    kind: 'exact',
+    path: TASK_BOARD_LEDGER_PATH,
+    handler: async (req, res) => {
+      if (!authorizeTaskBoardRequest(ctx, req)) {
+        json(res, 403, { code: 'forbidden' })
+        return
+      }
+      if (req.method === 'GET') {
+        json(res, 200, current())
+        return
+      }
+      if (req.method !== 'PUT') {
+        res.writeHead(405, { allow: 'GET, PUT' })
+        res.end()
+        return
+      }
+      if (!(req.headers['content-type'] ?? '').toLowerCase().startsWith('application/json')) {
+        json(res, 415, { code: 'unsupported-media-type' })
+        return
+      }
+      const body = await readWrite(req)
+      if (body === undefined) {
+        json(res, 400, { code: 'bad-request' })
+        return
+      }
+      let status = 200
+      let result = current()
+      const commit = writeTail.then(async () => {
+        const latest = current()
+        if (body.expectedRevision !== latest.revision) {
+          status = 409
+          result = latest
+          return
+        }
+        const next: TaskBoardLedger = {
+          revision: latest.revision + 1,
+          tasks: body.tasks,
+        }
+        await scope.replace(next)
+        result = current()
+        publish(result.revision)
+      })
+      writeTail = commit.then(() => undefined, () => undefined)
+      try {
+        await commit
+        json(res, status, result)
+      } catch (error) {
+        ctx.logger.warn(`dsh-task-board: ledger write failed: ${String(error)}`)
+        json(res, 500, { code: 'persist-failed' })
+      }
+    },
+  }
+
+  const events: WebRoute = {
+    kind: 'exact',
+    path: TASK_BOARD_EVENTS_PATH,
+    handler: (req, res) => {
+      if (req.method !== 'GET') {
+        res.writeHead(405, { allow: 'GET' })
+        res.end()
+        return
+      }
+      if (!authorizeTaskBoardRequest(ctx, req)) {
+        res.writeHead(403)
+        res.end()
+        return
+      }
+      res.writeHead(200, {
+        'content-type': 'text/event-stream; charset=utf-8',
+        'cache-control': 'no-cache',
+        connection: 'keep-alive',
+        'x-accel-buffering': 'no',
+      })
+      res.write(`retry: 2000\ndata: ${JSON.stringify({ revision: current().revision })}\n\n`)
+      const subscriber: Subscriber = { req, res }
+      subscribers.add(subscriber)
+      const close = (): void => { subscribers.delete(subscriber) }
+      req.on('close', close)
+      res.on('close', close)
+    },
+  }
+
+  const authorizationTimer = setInterval(() => {
+    for (const subscriber of [...subscribers]) {
+      if (!authorizeTaskBoardRequest(ctx, subscriber.req)) {
+        subscribers.delete(subscriber)
+        subscriber.res.end()
+      }
+    }
+  }, AUTH_RECHECK_MS)
+  authorizationTimer.unref()
+  const heartbeatTimer = setInterval(() => {
+    for (const subscriber of subscribers) subscriber.res.write(': ping\n\n')
+  }, HEARTBEAT_MS)
+  heartbeatTimer.unref()
+
+  const disposers = [ctx.webServer.register(ledger), ctx.webServer.register(events)]
+  return () => {
+    for (const dispose of disposers) dispose()
+    clearInterval(authorizationTimer)
+    clearInterval(heartbeatTimer)
+    for (const subscriber of subscribers) subscriber.res.end()
+    subscribers.clear()
+  }
+}
